{
  "name": "ebook-reader",
  "version": "1.0.0",
  "description": "A private, offline desktop reader for TXT and EPUB books.",
  "main": ".vite/build/app.js",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint && npm test",
    "e2e": "playwright test"
  },
  "dependencies": {
    "epubjs": "0.3.93",
    "iconv-lite": "0.7.0",
    "jszip": "3.10.1",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.9.0",
    "@electron-forge/maker-deb": "7.9.0",
    "@electron-forge/maker-dmg": "7.9.0",
    "@electron-forge/maker-rpm": "7.9.0",
    "@electron-forge/maker-squirrel": "7.9.0",
    "@electron-forge/maker-zip": "7.9.0",
    "@electron-forge/plugin-vite": "7.9.0",
    "@eslint/js": "9.36.0",
    "@playwright/test": "1.55.1",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "24.5.2",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@typescript-eslint/eslint-plugin": "8.44.1",
    "@typescript-eslint/parser": "8.44.1",
    "@vitejs/plugin-react": "5.0.4",
    "electron": "38.1.2",
    "eslint": "9.36.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "jsdom": "26.1.0",
    "typescript": "5.9.2",
    "vite": "7.1.7",
    "vitest": "3.2.4"
  }
}
